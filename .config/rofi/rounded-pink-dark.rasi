 @import "~/.config/rofi/colors.rasi"

* {
    font: "Cantarell bold 13";
    text-color: #1e1e2e;
    background-color: transparent;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
    highlight: none;
}


window {
    location: center;
    width: 450;
    border-radius: 30px;
    background-color: rgba(255, 255, 255, 0.2);
    border: 2px;
    border-color: @--col2;
}

mainbox {
    padding: 12px;
}


inputbar {
    children: [ entry ];
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    border: 1px solid;
    border-color: @--col2; 
    padding: 10px 16px;
    margin: 5px 0px 10px 0px; 
}


entry {
    font: "Cantarell bold 12";
    placeholder: "Search...";
    placeholder-color: #ffffff;
    text-color: @fg-col;
}


listview {
    background-color: transparent;
    margin: 12px 0 0;
    lines: 6;
    columns: 1;
    fixed-height: false;
}


element {
    padding: 10px 16px;
    spacing: 12px;
    border-radius: 13px;
    background-color: transparent;
}


element selected normal, element selected active {
    background-image: @sel-grad;
    border: 1px solid;
    text-color: #ffffff;
}


element-icon {
    size: 1.2em;
    vertical-align: 0.5;
}


element-text {
    text-color: inherit;
    vertical-align: 0.5;
} 
