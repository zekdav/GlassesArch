* {
    bg-col: #FFFCFFE6;
    fg-col: #040B19;
    border-col: #040B191A;
    sel-bg: #735C4180;
    --col0: #FFFEFF;
    --col1: #9D8AA5;
    --col2: #176DB2;
    --col3: #7D537C;
    --col4: #735C41;
    --col5: #3E0E09;
    --col8: #7F7286;
    
    sel-grad: linear-gradient(45deg, #176DB2, #7D537C);
}