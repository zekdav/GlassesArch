{
    "layer": "top",
    "position": "top",
    "height": 53,
    "spacing": 5,
    "margin-bottom": -11,
    "modules-left": [ "hyprland/workspaces" ],
    "modules-center": ["custom/dynamic_pill"],
    "modules-right": [ "network", "pulseaudio", "bluetooth", "battery", "temperature", "clock" ],
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-active": " {icon} ",
        "on-click": "activate"
    },
    "custom/dynamic_pill": {
        "return-type": "json",
        "format": "{}",
        "exec": "bash ~/.config/hypr/scripts/tools/start_dyn",
        "escape": true,
        "on-click": "swaync-client -t -sw",
        "on-click-middle": "python3 ~/.config/hypr/scripts/tools/dynamic --toggle",
        "on-click-right": "python3 ~/.config/hypr/scripts/tools/dynamic --next",
        "on-scroll-up": "python3 ~/.config/hypr/scripts/tools/dynamic --volume-up",
        "on-scroll-down": "python3 ~/.config/hypr/scripts/tools/dynamic --volume-down",
        "smooth-scrolling-threshold": 1
    },
    "clock": {
        "timezone": "Europe/Warsaw",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 60,
        "format": "{:%I:%M}",
        "max-length": 25
    },
    "temperature": {
        "critical-threshold": 95,
        "format-critical": "{temperatureC} °C ",
        "format": "{temperatureC} °C"
    },
    "temperature": {
        "critical-threshold": 95,
        "format-critical": "{temperatureC} °C ",
        "format": "{temperatureC} °C"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%  {icon}",
        "format-charging": "{capacity}% {icon}",
        "format-plugged": "{capacity}% {icon}",
        "tooltip-format": "{timeTo}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "    {essid}",
        "format-ethernet": " {ifname}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "format-icons": ["", "", "", ""],
        "on-click": "nm-connection-editor"
    },
   "bluetooth": {
        "format": " {status}",
        "format-connected": "{device_alias}",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{volume}%",
        "format-bluetooth": "{volume}%",
        "format-bluetooth-muted": " {icon}",
        "format-muted": " Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
}
